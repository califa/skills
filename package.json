{
  "name": "@califaco/skills",
  "version": "0.1.0",
  "description": "Interactive TUI for installing a bundled Agent Skills collection across coding harnesses.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/califa/skills.git"
  },
  "homepage": "https://github.com/califa/skills#readme",
  "bugs": {
    "url": "https://github.com/califa/skills/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "califa-skills": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "install.sh"
  ],
  "scripts": {
    "prebuild": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.build.json",
    "dev": "CALIFA_SKILLS_DIR=./skills tsx src/index.ts",
    "lint": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "agent-skills",
    "codex",
    "claude-code",
    "cursor",
    "tui"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
